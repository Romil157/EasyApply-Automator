# ─── EasyApply Automator – Environment Variables ──────────────────────────────
# Copy this file to ".env" (which is gitignored) and fill in real values.
# Values can also be exported in your shell; .env is loaded automatically via
# python-dotenv. All values are optional except where noted.

# ─── Authentication (used by login flow) ──────────────────────────────────────
# Login email is typed into the LinkedIn login page; password is typed manually
# in the browser window (never stored).
LINKEDIN_USERNAME=your_linkedin_login_email
LINKEDIN_PASSWORD=your_linkedin_password

# ─── Personal info auto-filled in Easy Apply forms ────────────────────────────
# High-sensitivity PII: sourced from env vars (not from questions_answers.yaml)
# to keep personal data out of git. questions_answers.yaml (gitignored) holds
# lower-sensitivity profile data like years of experience, university, and
# demographics. Rule answers in questions_answers.yaml reference these as
# {full_name}, {first_name}, {form_email}, {phone_number}, etc.
LINKEDIN_FULL_NAME=Your Full Name
LINKEDIN_FIRST_NAME=YourFirstName
LINKEDIN_LAST_NAME=YourLastName
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PHONE_NUMBER=+91XXXXXXXXXX
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile/
LINKEDIN_GITHUB_URL=https://github.com/your_username

# ─── Job search geo defaults ─────────────────────────────────────────────────
LINKEDIN_LOCATION_COUNTRY=IN
LINKEDIN_LOCATION_CITY="Mumbai"

# ─── Compensation expectations ───────────────────────────────────────────────
LINKEDIN_SALARY=180000
LINKEDIN_RATE=150

# ─── Advanced / troubleshooting ──────────────────────────────────────────────
# Setting EASYAPPLY_IGNORE_CERT_ERRORS to "1" disables TLS verification in the
# browser. Only enable this if you are behind a corporate proxy that intercepts
# HTTPS and the bot is otherwise failing on certificate errors.
# EASYAPPLY_IGNORE_CERT_ERRORS=0

# ─── AI / LLM Auto-Answer Engine (Optional) ──────────────────────────────
# When enabled, any questions not matching local YAML rules are answered zero-shot
# using your candidate profile and auto-learned to questions_answers.yaml for future reuse.
# AI_PROVIDER=auto                      # auto | gemini | openai | anthropic | ollama
# GEMINI_API_KEY=your_gemini_api_key    # Google Gemini Flash API key (Free tier supported)
# OPENAI_API_KEY=your_openai_api_key    # OpenAI / Groq / OpenRouter API key
# OPENAI_BASE_URL=https://api.openai.com/v1 # Or http://localhost:11434/v1 for local Ollama
# ANTHROPIC_API_KEY=your_claude_api_key # Anthropic Claude API key
# OLLAMA_HOST=http://localhost:11434    # Local Ollama endpoint
# AI_MODEL=gemini-1.5-flash             # gemini-1.5-flash | gpt-4o-mini | llama3.2
# AI_AUTO_LEARN=1                       # Auto-save AI answers into questions_answers.yaml


